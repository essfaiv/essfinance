<?xml version="1.0"?>
<ruleset name="EssFinance">
    <description>EssFinance WordPress Plugin — PHPCS + WPCS + PHPCompatibility</description>

    <!-- Scope: production files only. -->
    <file>essfinance.php</file>
    <file>uninstall.php</file>
    <file>includes/</file>

    <exclude-pattern>tests/</exclude-pattern>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>assets/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>bin/</exclude-pattern>
    <exclude-pattern>phpstan-bootstrap.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- ── WordPress Coding Standards ───────────────────────────────────── -->
    <rule ref="WordPress">
        <!-- File naming: project uses class-admin-page.php, not class-essf-admin-page.php. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

        <!-- Doc comment requirements: skip class/function/variable PHPDoc noise. -->
        <exclude name="Squiz.Commenting.ClassComment"/>
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
        <exclude name="Squiz.Commenting.VariableComment"/>
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>

        <!-- Template rendering uses mixed PHP/HTML patterns intentionally. -->
        <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen"/>
        <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd"/>
        <exclude name="Squiz.PHP.EmbeddedPhp.MultipleStatements"/>
        <exclude name="Generic.Formatting.DisallowMultipleStatements.SameLine"/>

        <!-- Chained assignments used intentionally in a few compact initializations. -->
        <exclude name="Squiz.PHP.DisallowMultipleAssignments"/>

        <!-- Short array syntax [] is preferred throughout the codebase. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>

        <!-- Direct $wpdb calls are intentional for this plugin's custom queries. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>

        <!-- Local file I/O for OFX/CSV parsing; not fetching remote resources. -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fopen"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fread"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fclose"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>

        <!-- GET-based filter/read params; state-changing ops use explicit nonce checks. -->
        <exclude name="WordPress.Security.NonceVerification.Recommended"/>

        <!-- meta_key queries are indexed; acceptable for this plugin's data model. -->
        <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key"/>

        <!-- Standard while($row = fgetcsv(...)) pattern for CSV iteration. -->
        <exclude name="Generic.CodeAnalysis.AssignmentInCondition.FoundInWhileCondition"/>

        <!-- WP hook callbacks must match expected signature even when trailing params are unused. -->
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>

        <!-- @var type-hint block comments trigger false-positive "commented out code" warnings. -->
        <exclude name="Squiz.PHP.CommentedOutCode.Found"/>

        <!-- Single-purpose @var/@param docblocks don't need a separate short description. -->
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    </rule>

    <!-- Enforce correct text domain (PHPCS 3.3+ array element syntax). -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="essfinance"/>
            </property>
        </properties>
    </rule>

    <!-- ── PHP Compatibility ─────────────────────────────────────────────── -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.2-"/>
    <config name="minimum_wp_version" value="4.9"/>

</ruleset>
