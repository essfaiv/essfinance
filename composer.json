{
  "name": "essfinance/essfinance",
  "description": "Simple personal finance management plugin for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "brain/monkey": "^2.6",
    "phpstan/phpstan": "^1.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wp-cli-stubs": "^2.12"
  },
  "autoload-dev": {
    "psr-4": {
      "EssFinance\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "install-hooks": "@php bin/install-hooks.php",
    "post-install-cmd": "@install-hooks",
    "post-update-cmd": "@install-hooks"
  }
}
